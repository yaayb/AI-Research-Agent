# DeepBrief AI configuration. Copy to .env (repo root or backend/) and fill in keys.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: when empty the keyless ddgs metasearch fallback is used.
TAVILY_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/research.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
REPORTS_DIR=./data/reports
MAX_ITERATIONS=3
# true -> deterministic fixtures + scripted LLM (no network, no API keys needed)
OFFLINE_TEST_MODE=false
